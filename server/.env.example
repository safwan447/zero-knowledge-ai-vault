# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/zk-vault?retryWrites=true&w=majority

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# AI API (used server-side only, after decrypting prompt in-memory)
ANTHROPIC_API_KEY=your_key_here

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
